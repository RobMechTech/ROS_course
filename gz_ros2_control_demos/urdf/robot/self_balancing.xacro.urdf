<?xml version="1.0"?>
<robot
  name="gz_ros2_control_demos" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="https://gazebosim.org/schema">

  <link name ="base_footprint"/>

  <joint name ="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 1.54"/>
  </joint>

  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-0.00018472 -0.00029391 0.029149"
        rpy="0 0 0" />
      <mass
        value="0.24444" />
      <inertia
        ixx="4.9685E-05"
        ixy="3.1749E-07"
        ixz="2.8457E-07"
        iyy="5.4818E-05"
        iyz="2.5866E-07"
        izz="8.7685E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find gz_ros2_control_demos)/meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find gz_ros2_control_demos)/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link
    name="left_wheel_link">
    <inertial>
      <origin
        xyz="-4.5978E-06 -2.6083E-06 -0.013677"
        rpy="0 0 0" />
      <mass
        value="0.074854" />
      <inertia
        ixx="3.063E-05"
        ixy="5.9387E-09"
        ixz="-9.5478E-12"
        iyy="3.0623E-05"
        iyz="8.9095E-11"
        izz="5.3045E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find gz_ros2_control_demos)/meshes/left_wheel_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.29412 0.29412 0.29412 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find gz_ros2_control_demos)/meshes/left_wheel_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="left_wheel_joint"
    type="continuous">
    <origin
      xyz="0.072 0 -0.019"
      rpy="-1.5708 -0.56139 1.5708" />
    <parent
      link="base_link" />
    <child
      link="left_wheel_link" />
    <axis
      xyz="0 0 -1" />
    <limit
      effort="4"
      velocity="60" />
    <dynamics
      friction="0.9" />
  </joint>
  <link
    name="right_wheel_link">
    <inertial>
      <origin
        xyz="-4.5978E-06 -2.6083E-06 0.013652"
        rpy="0 0 0" />
      <mass
        value="0.074854" />
      <inertia
        ixx="3.063E-05"
        ixy="5.9387E-09"
        ixz="-9.5471E-12"
        iyy="3.0623E-05"
        iyz="8.9095E-11"
        izz="5.3045E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find gz_ros2_control_demos)/meshes/right_wheel_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.29412 0.29412 0.29412 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find gz_ros2_control_demos)/meshes/right_wheel_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="right_wheel_joint"
    type="continuous">
    <origin
      xyz="-0.072 0 -0.019"
      rpy="-1.5708 1.2911 1.5708" />
    <parent
      link="base_link" />
    <child
      link="right_wheel_link" />
    <axis
      xyz="0 0 -1" />
    <limit
      effort="4"
      velocity="60" />
    <dynamics
      friction="0.9" />
  </joint>

  
  
  <link
    name="imu_link">
    <inertial>
      <origin
        xyz="5.8068E-05 -0.00023678 -0.0009295"
        rpy="0 0 0" />
      <mass
        value="0.0010017" />
      <inertia
        ixx="1.6953E-08"
        ixy="3.3681E-18"
        ixz="1.306E-11"
        iyy="4.6329E-08"
        iyz="-6.2461E-14"
        izz="3.0394E-08" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find gz_ros2_control_demos)/meshes/imu_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.52941 0.54902 0.54902 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find gz_ros2_control_demos)/meshes/imu_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="imu_joint"
    type="fixed">
    <origin
      xyz="-7.37E-05 0.018866 0.12371"
      rpy="1.5708 0 0" />
    <parent
      link="base_link" />
    <child
      link="imu_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <xacro:include filename="$(find gz_ros2_control_demos)/urdf/control/ros2_control.xacro.urdf" />
  <xacro:include filename="$(find gz_ros2_control_demos)/urdf/sensors/imu_gazebo.xacro.urdf" />
  
</robot>